{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "productName": "bewCloud Desktop Sync",
  "mainBinaryName": "bewCloud Desktop Sync",
  "version": "0.0.6",
  "identifier": "com.bewcloud.sync",
  "plugins": {},
  "app": {
    "trayIcon": {
      "iconPath": "icons/sync-unset.png",
      "iconAsTemplate": true,
      "title": "bewCloud Desktop Sync"
    },
    "windows": [
      {
        "title": "bewCloud Desktop Sync",
        "width": 800,
        "height": 600,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
